{
  "name": "@commercetools-labs/contentools",
  "version": "1.0.0",
  "private": true,
  "description": "Tooling hub for the Contentools reference implementation. Not a workspace root: each Connect app is self-contained.",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "install:all": "node tools/run-all.mjs install",
    "build": "node tools/run-all.mjs build",
    "typecheck": "node tools/run-all.mjs typecheck",
    "lint": "node tools/run-all.mjs lint",
    "test": "node tools/run-all.mjs test",
    "test:e2e": "node tools/run-all.mjs test:e2e",
    "verify": "node tools/verify.mjs",
    "verify:strict": "node tools/verify.mjs --strict",
    "verify:service": "yarn --cwd service install --frozen-lockfile && yarn --cwd service typecheck && yarn --cwd service lint && yarn --cwd service test && yarn --cwd service build",
    "verify:mcp": "yarn --cwd mcp install --frozen-lockfile && yarn --cwd mcp check:app && yarn --cwd mcp check:connect-block",
    "headers": "node tools/labs-publish.mjs ossify --apply",
    "dev:fake-ct": "node --experimental-strip-types tools/fake-ct/server.mjs",
    "check:spdx": "node tools/check-spdx-headers.mjs",
    "check:forbidden": "node tools/check-forbidden-terms.mjs",
    "check:legacy-calls": "node tools/check-legacy-route-calls.mjs",
    "check:hygiene": "node tools/check-repo-hygiene.mjs",
    "check:connect": "node tools/check-connect-contract.mjs",
    "release:puck:bump": "node tools/release/puck-script.mjs release:bump",
    "release:puck:publish": "node tools/release/puck-script.mjs release:publish",
    "release:preflight": "node tools/release/preflight.mjs",
    "release:tag": "node tools/release/tag.mjs",
    "docs:check": "node tools/check-docs-lint.mjs && node tools/check-docs-config.mjs && node tools/check-docs-postman.mjs",
    "test:tools": "node --test \"tools/test/*.test.mjs\"",
    "gate": "node tools/labs-publish.mjs gate",
    "check:admin-app-connect": "node tools/check-admin-app-connect.mjs",
    "check:admin-app-build": "node tools/admin-app-simulate-connect-build.mjs",
    "admin-app:local-puck": "node tools/admin-app-use-local-puck.mjs"
  }
}
