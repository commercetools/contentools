{
  "description": "AI SDK, LangChain and MCP tools for the Contentools content service",
  "license": "MIT",
  "type": "commonjs",
  "sideEffects": false,
  "engines": { "node": ">=20" },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": { "contentools-mcp": "./dist/stdio/index.js" },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": { "access": "public" },
  "keywords": ["commercetools", "contentools", "mcp", "model-context-protocol", "ai-sdk", "langchain", "puck"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/commercetools/contentools.git",
    "directory": "mcp"
  },
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.mts", "default": "./dist/index.mjs" },
      "require": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
    },
    "./ai-sdk": {
      "import": { "types": "./dist/ai-sdk/index.d.mts", "default": "./dist/ai-sdk/index.mjs" },
      "require": { "types": "./dist/ai-sdk/index.d.ts", "default": "./dist/ai-sdk/index.js" }
    },
    "./langchain": {
      "import": { "types": "./dist/langchain/index.d.mts", "default": "./dist/langchain/index.mjs" },
      "require": { "types": "./dist/langchain/index.d.ts", "default": "./dist/langchain/index.js" }
    },
    "./mcp": {
      "import": { "types": "./dist/mcp/index.d.mts", "default": "./dist/mcp/index.mjs" },
      "require": { "types": "./dist/mcp/index.d.ts", "default": "./dist/mcp/index.js" }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "ai-sdk": ["dist/ai-sdk/index.d.ts"],
      "langchain": ["dist/langchain/index.d.ts"],
      "mcp": ["dist/mcp/index.d.ts"]
    }
  },
  "peerDependencies": {
    "zod": "^3.25.0 || ^4.0.0",
    "ai": "^6.0.0 || ^7.0.0",
    "@langchain/core": "^0.3.0 || ^1.0.0",
    "@modelcontextprotocol/sdk": ">=1.27.0 <2"
  },
  "peerDependenciesMeta": {
    "ai": { "optional": true },
    "@langchain/core": { "optional": true },
    "@modelcontextprotocol/sdk": { "optional": true }
  }
}
