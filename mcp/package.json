{
  "name": "@commercetools-labs/contentools-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Model Context Protocol server (Streamable HTTP) for the Contentools content service",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "build/server/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "gcp-build": "tsc -p tsconfig.build.json",
    "start": "node build/server/index.js",
    "start:dev": "tsx watch src/server/index.ts",
    "dev:fake": "tsx tests/support/dev-fake.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "jest tests/e2e",
    "verify": "node scripts/verify-mcp.mjs",
    "check:app": "yarn typecheck && yarn test && yarn gcp-build",
    "connector:post-deploy": "node build/server/post-deploy.js",
    "check:connect-block": "node scripts/check-connect.mjs",
    "build:npm": "tsup",
    "verify:package": "node scripts/verify-package.mjs",
    "publish:npm": "node scripts/publish.mjs",
    "clean": "rm -rf dist build .publish"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "^4.21.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@langchain/core": "^0.3.80",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.0",
    "@types/supertest": "^6.0.2",
    "ai": "^6.0.116",
    "jest": "^29.7.0",
    "msw": "^2.15.0",
    "publint": "^0.3.25",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "yaml": "^2.9.1"
  },
  "resolutions": {
    "langsmith": ">=0.8.0 <1.0.0",
    "uuid": "^11.1.1"
  }
}
