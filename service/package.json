{
  "name": "@commercetools-labs/contentools-service",
  "version": "1.0.0",
  "private": true,
  "description": "Contentools service: content API on commercetools Custom Objects (Connect service application)",
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22"
  },
  "main": "build/index.js",
  "scripts": {
    "build": "rimraf build && tsc -p tsconfig.build.json && node scripts/bundle-lifecycle.mjs",
    "gcp-build": "yarn build",
    "start": "node build/index.js",
    "start:dev": "concurrently -k \"tsc -p tsconfig.build.json --watch\" \"node --env-file=.env --watch build/index.js\"",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"{src,tests}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config e2e/jest.config.js --runInBand",
    "test:e2e:media": "jest --config e2e/jest.config.js --runInBand e2e/media",
    "test:live": "jest -c jest.live.config.cjs",
    "connector:post-deploy": "node build/connector/post-deploy.js",
    "connector:pre-undeploy": "node build/connector/pre-undeploy.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.772.0",
    "@babel/standalone": "^7.28.0",
    "@commercetools-backend/express": "^27.13.0",
    "@commercetools-backend/loggers": "^27.13.0",
    "@commercetools/platform-sdk": "^8.27.0",
    "@commercetools/ts-client": "^4.10.0",
    "@google-cloud/storage": "^8",
    "cloudinary": "^2.6.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^2.2.0",
    "winston": "^3.17.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/babel__standalone": "^7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.13.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "aws-sdk-client-mock": "^4",
    "concurrently": "^9.0.0",
    "dotenv": "^16.3.1",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jose": "^5.10.0",
    "msw": "2.10.5",
    "prettier": "^3.3.0",
    "rimraf": "^6.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.8.3",
    "yaml": "^2.9.1"
  },
  "resolutions": {
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^4.19.6"
  }
}
