# Local development only: copy to .env and fill in. `.env` is git-ignored.
# Load it with `node --env-file=.env ...` (yarn start:dev does this).
# In Connect the CTP_* values are injected by the platform (inheritAs.apiClient) and are never
# declared in connect.yaml. Locally, create an API client with exactly these two scopes:
# manage_key_value_documents and view_products.
CTP_API_URL=https://api.<region>.commercetools.com
CTP_AUTH_URL=https://auth.<region>.commercetools.com
CTP_PROJECT_KEY=<project-key>
CTP_CLIENT_ID=<client-id>
CTP_CLIENT_SECRET=<client-secret>
CTP_SCOPE=manage_key_value_documents:<project-key> view_products:<project-key>
PORT=8080

# Every key below is declared in ../connect.yaml. Empty means "use the default / not set".
LOG_LEVEL=info
MAX_VERSIONS=5
CONTAINER_PREFIX=

# Authentication. Connect provides CONNECT_SERVICE_URL; locally use an https tunnel URL ending in /service.
# Without it only SERVICE_API_TOKEN works (Merchant Center tokens cannot be verified).
# CONNECT_SERVICE_URL=
CLOUD_IDENTIFIER=
# At least 32 characters, for example: openssl rand -hex 24
SERVICE_API_TOKEN=
CORS_ALLOWED_ORIGINS=
MC_REQUIRED_PERMISSION=
PUBLIC_DATASOURCE_RESOLVE=false
PUBLIC_RESOLVE_MAX_PER_MINUTE=120

# Media storage (optional; provider none = the media endpoints answer 501).
# Buckets must allow public read of the media prefix. Fill one provider block.
MEDIA_STORAGE_PROVIDER=none
MEDIA_PATH_PREFIX=contentools/media
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,image/avif,application/pdf
MEDIA_PUBLIC_BASE_URL=
# gcp: bucket plus ONE base64 service-account JSON key (base64 -i key.json | tr -d '\n')
MEDIA_GCP_BUCKET=
MEDIA_GCP_SERVICE_ACCOUNT_KEY_B64=
# aws: S3 or an S3-compatible server (set MEDIA_AWS_ENDPOINT)
MEDIA_AWS_BUCKET=
MEDIA_AWS_REGION=us-east-1
MEDIA_AWS_ENDPOINT=
MEDIA_AWS_ACCESS_KEY_ID=
MEDIA_AWS_SECRET_ACCESS_KEY=
# cloudinary
MEDIA_CLOUDINARY_CLOUD_NAME=
MEDIA_CLOUDINARY_API_KEY=
MEDIA_CLOUDINARY_API_SECRET=
