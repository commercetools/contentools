# Local development only. In Connect these CTP_* values are injected by the platform
# (inheritAs.apiClient); never declare them in connect.yaml.
CTP_API_URL=https://api.europe-west1.gcp.commercetools.com
CTP_AUTH_URL=https://auth.europe-west1.gcp.commercetools.com
CTP_PROJECT_KEY=your-project-key
CTP_CLIENT_ID=your-client-id
CTP_CLIENT_SECRET=your-client-secret
CTP_SCOPE=manage_key_value_documents:your-project-key view_products:your-project-key
PORT=8080
LOG_LEVEL=debug
MAX_VERSIONS=5
CONTAINER_PREFIX=

# Authentication. CONNECT_SERVICE_URL is provided by Connect; locally use an https tunnel URL ending in /service.
# CONNECT_SERVICE_URL=https://your-service.example/service
# CLOUD_IDENTIFIER=gcp-eu
# SERVICE_API_TOKEN=generate-with-openssl-rand-hex-24
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# MC_REQUIRED_PERMISSION=canManageContentools
# PUBLIC_DATASOURCE_RESOLVE=false
# PUBLIC_RESOLVE_MAX_PER_MINUTE=120

# Media storage (optional; default provider none = media endpoints answer 501).
# Buckets must allow public read of the media prefix. One block per provider.
MEDIA_STORAGE_PROVIDER=
MEDIA_PATH_PREFIX=
MEDIA_MAX_UPLOAD_BYTES=
MEDIA_ALLOWED_MIME_TYPES=
MEDIA_PUBLIC_BASE_URL=
# gcp: bucket plus ONE base64 service-account JSON key (base64 -i key.json | tr -d '\n')
MEDIA_GCP_BUCKET=
MEDIA_GCP_SERVICE_ACCOUNT_KEY_B64=
# aws: S3 or an S3-compatible server (set MEDIA_AWS_ENDPOINT)
MEDIA_AWS_BUCKET=
MEDIA_AWS_REGION=
MEDIA_AWS_ENDPOINT=
MEDIA_AWS_ACCESS_KEY_ID=
MEDIA_AWS_SECRET_ACCESS_KEY=
# cloudinary
MEDIA_CLOUDINARY_CLOUD_NAME=
MEDIA_CLOUDINARY_API_KEY=
MEDIA_CLOUDINARY_API_SECRET=
