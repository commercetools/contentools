{
  "name": "@commercetools-labs/puck-types",
  "version": "1.0.0-rc.0",
  "description": "TypeScript types for the Puck page content integration",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/commercetools/contentools.git",
    "directory": "puck/packages/puck-types"
  },
  "bugs": {
    "url": "https://github.com/commercetools/contentools/issues"
  },
  "homepage": "https://github.com/commercetools/contentools/tree/main/puck/packages/puck-types#readme",
  "keywords": [
    "commercetools",
    "puck",
    "page-builder",
    "react"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@measured/puck": "^0.18.2"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.7.2"
  }
}
