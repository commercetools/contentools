{
  "name": "@commercetools-labs/puck-image-picker",
  "version": "1.0.0-rc.0",
  "description": "Standalone ImagePickerField component with media library support",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/commercetools/contentools.git",
    "directory": "puck/packages/puck-image-picker"
  },
  "bugs": {
    "url": "https://github.com/commercetools/contentools/issues"
  },
  "homepage": "https://github.com/commercetools/contentools/tree/main/puck/packages/puck-image-picker#readme",
  "keywords": [
    "commercetools",
    "puck",
    "page-builder",
    "react"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@commercetools-labs/puck-api": "workspace:^",
    "@commercetools-labs/puck-types": "workspace:^"
  },
  "peerDependencies": {
    "@chakra-ui/react": "^3.36.0",
    "@commercetools/nimbus": "^3.2.0",
    "@commercetools/nimbus-icons": "^3.2.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "react-intl": ">=6.0.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsup": "^8.3.0",
    "typescript": "^5.7.2"
  }
}
